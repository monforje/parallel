{
  "format_on_save": "on",
  "tab_size": 4,
  "languages": {
    "C++": { "formatter": "language_server" },
    "C": { "formatter": "language_server" }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": ["--background-index", "--query-driver=/usr/bin/gcc,/usr/bin/g++,/usr/bin/clang,/usr/bin/clang++", "--clang-tidy", "--header-insertion=never"]
      }
    }
  }
}
